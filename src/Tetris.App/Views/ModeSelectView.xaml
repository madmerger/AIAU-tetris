<UserControl x:Class="Tetris.App.Views.ModeSelectView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource BackgroundBrush}">
    <Viewbox Stretch="Uniform" Margin="24">
        <StackPanel Width="420" HorizontalAlignment="Center">
            <TextBlock Text="AIAU TETRIS"
                       FontFamily="Consolas"
                       FontSize="46"
                       FontWeight="Bold"
                       Foreground="{StaticResource AccentBrush}"
                       HorizontalAlignment="Center" />
            <TextBlock Text="Windows ネイティブ版"
                       FontFamily="Consolas"
                       FontSize="16"
                       Foreground="{StaticResource SubTextBrush}"
                       HorizontalAlignment="Center"
                       Margin="0,4,0,32" />

            <Border x:Name="StageOption"
                    CornerRadius="6"
                    BorderThickness="2"
                    Padding="18,14"
                    Margin="0,0,0,12"
                    MouseLeftButtonDown="OnStageOptionClicked">
                <StackPanel>
                    <TextBlock Text="STAGE MODE"
                               FontFamily="Consolas"
                               FontSize="24"
                               Foreground="{StaticResource TextBrush}" />
                    <TextBlock Text="20 面の固定配置。ジェムを全消しでクリア。"
                               FontFamily="Consolas"
                               FontSize="13"
                               Foreground="{StaticResource SubTextBrush}"
                               Margin="0,4,0,0" />
                </StackPanel>
            </Border>

            <Border x:Name="InfiniteOption"
                    CornerRadius="6"
                    BorderThickness="2"
                    Padding="18,14"
                    Margin="0,0,0,28"
                    MouseLeftButtonDown="OnInfiniteOptionClicked">
                <StackPanel>
                    <TextBlock Text="INFINITE MODE"
                               FontFamily="Consolas"
                               FontSize="24"
                               Foreground="{StaticResource TextBrush}" />
                    <TextBlock Text="空の盤面でゲームオーバーまで継続。"
                               FontFamily="Consolas"
                               FontSize="13"
                               Foreground="{StaticResource SubTextBrush}"
                               Margin="0,4,0,0" />
                </StackPanel>
            </Border>

            <Button x:Name="StartButton"
                    Content="ゲーム開始 (Enter)"
                    FontSize="20"
                    Padding="16,12"
                    Click="OnStartClicked" />

            <TextBlock FontFamily="Consolas"
                       FontSize="12"
                       Foreground="{StaticResource SubTextBrush}"
                       TextAlignment="Center"
                       Margin="0,20,0,0"
                       Text="← → 移動 / ↑ 回転 / ↓ ソフトドロップ / Space ハードドロップ / P ポーズ" />
        </StackPanel>
    </Viewbox>
</UserControl>
