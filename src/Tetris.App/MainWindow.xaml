<Window x:Class="Tetris.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TETRIS" Height="820" Width="700"
        MinHeight="480" MinWidth="420"
        Background="{StaticResource BackgroundBrush}"
        WindowStartupLocation="CenterScreen">
    <Grid>
        <!-- モード選択画面 -->
        <Viewbox x:Name="ModeSelectView" Stretch="Uniform" Margin="24">
            <StackPanel Width="360" HorizontalAlignment="Center">
                <TextBlock Text="TETRIS" FontFamily="Consolas" FontSize="64" FontWeight="Bold"
                           Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Center" />
                <TextBlock Text="Windows ネイティブ版" FontFamily="Consolas" FontSize="16"
                           Foreground="{StaticResource SubTextBrush}" HorizontalAlignment="Center"
                           Margin="0,0,0,36" />
                <ToggleButton x:Name="StageModeButton" Style="{StaticResource ModeButton}"
                              Content="STAGE MODE" Click="ModeButton_Click" />
                <ToggleButton x:Name="InfiniteModeButton" Style="{StaticResource ModeButton}"
                              Content="INFINITE MODE" IsChecked="True" Click="ModeButton_Click" />
                <Button x:Name="StartButton" Style="{StaticResource GameButton}" Content="ゲーム開始"
                        FontSize="20" Height="52" Margin="0,20,0,0" Click="StartButton_Click" />
                <TextBlock x:Name="ModeDescription" Style="{StaticResource LabelText}" FontSize="13"
                           TextWrapping="Wrap" TextAlignment="Center" Margin="0,24,0,0" />
                <TextBlock Style="{StaticResource LabelText}" FontSize="12" TextAlignment="Center" Margin="0,24,0,0"
                           Text="← → 移動 ／ ↑ 右回転 ／ ↓ ソフトドロップ&#10;Space ハードドロップ ／ P ポーズ" />
            </StackPanel>
        </Viewbox>

        <!-- ゲーム画面 -->
        <Viewbox x:Name="GameView" Stretch="Uniform" Visibility="Collapsed" Margin="16">
            <Grid Width="520" Height="640">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Background="{StaticResource PanelBrush}" BorderBrush="#2C3348"
                        BorderThickness="2" CornerRadius="6" Padding="4">
                    <Grid>
                        <Canvas x:Name="BoardCanvas" />
                        <Border x:Name="OverlayPanel" Background="#C00E0F16" Visibility="Collapsed">
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock x:Name="OverlayTitle" FontFamily="Consolas" FontSize="34" FontWeight="Bold"
                                           Foreground="{StaticResource AccentBrush}" TextAlignment="Center"
                                           TextWrapping="Wrap" />
                                <TextBlock x:Name="OverlayDetail" FontFamily="Consolas" FontSize="18"
                                           Foreground="{StaticResource TextBrush}" TextAlignment="Center"
                                           Margin="0,12,0,0" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>

                <StackPanel Grid.Column="1" Margin="16,0,0,0">
                    <TextBlock Style="{StaticResource LabelText}" Text="NEXT" />
                    <Border Background="{StaticResource PanelBrush}" BorderBrush="#2C3348" BorderThickness="1"
                            CornerRadius="4" Padding="6" Margin="0,4,0,14" HorizontalAlignment="Left">
                        <Canvas x:Name="NextCanvas" />
                    </Border>

                    <TextBlock Style="{StaticResource LabelText}" Text="MODE" />
                    <TextBlock x:Name="ModeText" Style="{StaticResource ValueText}" FontSize="16" />

                    <TextBlock x:Name="StageLabel" Style="{StaticResource LabelText}" Text="STAGE" />
                    <TextBlock x:Name="StageText" Style="{StaticResource ValueText}" />

                    <TextBlock Style="{StaticResource LabelText}" Text="TIME" />
                    <TextBlock x:Name="TimeText" Style="{StaticResource ValueText}" Text="00:00:00" />

                    <TextBlock Style="{StaticResource LabelText}" Text="SCORE" />
                    <TextBlock x:Name="ScoreText" Style="{StaticResource ValueText}" Text="0" />

                    <TextBlock Style="{StaticResource LabelText}" Text="LEVEL" />
                    <TextBlock x:Name="LevelText" Style="{StaticResource ValueText}" Text="1" />

                    <TextBlock Style="{StaticResource LabelText}" Text="LINES" />
                    <TextBlock x:Name="LinesText" Style="{StaticResource ValueText}" Text="0" />

                    <Button x:Name="PauseButton" Style="{StaticResource GameButton}" Content="ポーズ (P)"
                            Click="PauseButton_Click" Margin="0,10,0,6" />
                    <Button x:Name="RestartButton" Style="{StaticResource GameButton}" Content="リスタート"
                            Click="RestartButton_Click" />
                    <Button x:Name="MuteButton" Style="{StaticResource GameButton}" Content="ミュート: OFF"
                            Click="MuteButton_Click" />
                    <Button x:Name="BackButton" Style="{StaticResource GameButton}" Content="モード選択へ戻る"
                            Click="BackButton_Click" />
                </StackPanel>
            </Grid>
        </Viewbox>
    </Grid>
</Window>
