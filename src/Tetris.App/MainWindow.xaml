<Window x:Class="Tetris.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:Tetris.App.Views"
        Title="AIAU Tetris"
        Width="760"
        Height="660"
        MinWidth="480"
        MinHeight="420"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BackgroundBrush}"
        KeyDown="OnWindowKeyDown"
        KeyUp="OnWindowKeyUp">
    <Grid>
        <views:ModeSelectView x:Name="ModeSelect" />
        <views:GameView x:Name="Game" Visibility="Collapsed" />
    </Grid>
</Window>
